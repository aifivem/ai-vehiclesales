{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-vehiclesales/data/lots.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "ped": {
          "type": "object",
          "properties": {
            "model": {
              "description": "Model: The ped model; empty means no NPC. Players see it within 50 m.",
              "type": "string",
              "maxLength": 64
            },
            "scenario": {
              "description": "What it does: An idle animation the NPC plays on the spot.",
              "enum": [
                "",
                "WORLD_HUMAN_STAND_IMPATIENT",
                "WORLD_HUMAN_CLIPBOARD",
                "WORLD_HUMAN_STAND_MOBILE",
                "WORLD_HUMAN_AA_COFFEE",
                "WORLD_HUMAN_SMOKING",
                "WORLD_HUMAN_GUARD_STAND",
                "WORLD_HUMAN_COP_IDLES",
                "WORLD_HUMAN_HANG_OUT_STREET"
              ]
            },
            "coords": {
              "description": "Where it stands: The NPC's floor spot and the way it faces (scroll in the free camera); without one it stands on the place's point.",
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "heading"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "heading": {
                  "type": "number"
                }
              }
            }
          },
          "required": []
        },
        "label": {
          "description": "Lot name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "coords": {
          "description": "Counter: Stand where players open the list of vehicles for sale and use your position.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "radius": {
          "description": "Counter reach",
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "area": {
          "description": "Lot size: Metres around the counter. Parked cars show to players inside, and buyers must be inside to buy or test drive.",
          "type": "number",
          "minimum": 20,
          "maximum": 300
        },
        "sell": {
          "description": "Sell spot: Where players drive in with the vehicle they want to sell.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "spots": {
          "description": "Spots",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "coords": {
                "description": "Spot",
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z",
                  "heading"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "heading": {
                    "type": "number"
                  }
                }
              }
            },
            "required": [
              "coords"
            ]
          }
        },
        "preview": {
          "description": "Preview spot: Stand where the shown vehicle should be, facing its front direction.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "camera": {
          "description": "Camera: Look at the preview spot with the game camera and use the camera position.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "delivery": {
          "description": "Delivery spot: A free place on the road, facing the way out. It may be the preview spot.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "blip": {
          "description": "Map blip",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "coords",
        "radius",
        "area",
        "sell",
        "spots",
        "preview",
        "camera",
        "delivery",
        "blip"
      ]
    }
  },
  "additionalProperties": false
}
